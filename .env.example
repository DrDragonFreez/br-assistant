# cp .env.example .env  &&  заполнить секреты
# ─────────────────────────────── APP ───────────────────────────────
APP_NAME="BR Document Assistant"
APP_ENV=production                  # local | production
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=info                      # debug | info | warning | error
LOG_FORMAT=json                     # json | console
TZ=Europe/Moscow
HTTP_PORT=80
UVICORN_WORKERS=2
API_V1_PREFIX=/api/v1
# Префикс, который срезает обратный прокси. Текущий infra/nginx/nginx.conf
# передаёт путь без изменений, поэтому значение пустое. Непустое значение
# вместе с API_V1_PREFIX=/api/v1 отдаёт 404 на всё API: Starlette вырезает
# root_path из пути до сопоставления маршрута.
API_ROOT_PATH=
# PROMETHEUS_MULTIPROC_DIR задан в backend/Dockerfile (/app/artifacts/prometheus)
# и переопределять его здесь не нужно.

# ─────────────────────────────── SECURITY ───────────────────────────────
# openssl rand -hex 32
SECRET_KEY=CHANGE_ME_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=br-assistant
PASSWORD_MIN_LENGTH=10
# Частоту запросов ограничивает Nginx (infra/nginx/nginx.conf):
# auth 5/мин, chat 20/мин, upload 10/мин, остальное 60/мин.
CORS_ORIGINS=http://localhost,http://localhost:3000
# Допустимые значения заголовка Host. «*» — проверка выключена:
# ограничивать Host должен обратный прокси, которому известны реальные
# имена контура. Жёсткий список здесь ломает доступ по IP-адресу машины.
TRUSTED_HOSTS=*
# Первый админ создаётся сидом
BOOTSTRAP_ADMIN_EMAIL=admin@cbr.local
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_strong_password
# Маскирование ПДн в логах/трейсах
PII_REDACTION_ENABLED=true

# ─────────────────────────────── POSTGRES ───────────────────────────────
POSTGRES_USER=br_user
POSTGRES_PASSWORD=CHANGE_ME_db_password
POSTGRES_DB=br_assistant
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://br_user:CHANGE_ME_db_password@postgres:5432/br_assistant
DATABASE_URL_SYNC=postgresql+psycopg2://br_user:CHANGE_ME_db_password@postgres:5432/br_assistant
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800
DB_ECHO=false

# ─────────────────────────────── REDIS ───────────────────────────────
REDIS_PASSWORD=CHANGE_ME_redis_password
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://:CHANGE_ME_redis_password@redis:6379/0
CELERY_BROKER_URL=redis://:CHANGE_ME_redis_password@redis:6379/1
CELERY_RESULT_BACKEND=redis://:CHANGE_ME_redis_password@redis:6379/2
CELERY_CONCURRENCY=2
CACHE_TTL_SECONDS=3600
SESSION_TTL_SECONDS=86400

# ─────────────────────────────── QDRANT ───────────────────────────────
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=CHANGE_ME_qdrant_api_key
QDRANT_COLLECTION=br_regulations
QDRANT_PREFER_GRPC=false
VECTOR_SIZE=1024                    # bge-m3 -> 1024
# Выдачи dense и sparse сливает Qdrant алгоритмом RRF: он работает
# с позициями документов, а не с их оценками, поэтому весов у него нет.
HYBRID_SEARCH_ENABLED=true

# ─────────────────────────────── OLLAMA / LLM ───────────────────────────────
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_LLM_MODEL=qwen2.5:7b-instruct
OLLAMA_FT_MODEL=br-assistant            # собирается из ml/modelfiles/Modelfile
OLLAMA_MODEL_ACTIVE=br-assistant        # что реально дергает generator; fallback -> OLLAMA_LLM_MODEL
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_SYNTH_MODEL=qwen2.5:14b-instruct # только для ml/synth_dataset.py
OLLAMA_KEEP_ALIVE=24h
OLLAMA_NUM_PARALLEL=2
OLLAMA_MAX_LOADED_MODELS=2
LLM_TEMPERATURE=0.1
LLM_TOP_P=0.9
LLM_MAX_TOKENS=1536
LLM_CONTEXT_WINDOW=8192
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3
LLM_RETRY_BACKOFF_BASE=1.5
LLM_FALLBACK_ENABLED=true

# ─────────────────────────────── RERANKER ───────────────────────────────
# По умолчанию выключен, и сервис реранкера при обычном `make up` не
# поднимается: он объявлен за профилем Compose. Причина — видеопамять:
# bge-reranker-v2-m3 занимает около 2,5 ГБ поверх qwen2.5-7b (5,5 ГБ при
# окне 8192) и bge-m3, то есть нужна карта от 12 ГБ. При выключенном
# реранкере граф переходит на MMR-переранжирование, качество поиска ниже.
#
# Включить: RERANKER_ENABLED=true и `make up-rerank`. Значение true при
# неподнятом сервисе работу не ломает — первый запрос получит отказ
# соединения, после чего граф до перезапуска работает на MMR.
RERANKER_ENABLED=false
RERANKER_URL=http://reranker:7997
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_TOP_N=5
RERANKER_TIMEOUT_SECONDS=30

# ─────────────────────────────── RAG ───────────────────────────────
CHUNK_SIZE=900
CHUNK_OVERLAP=150
RETRIEVER_TOP_K=20
RETRIEVER_SCORE_THRESHOLD=0.35
# Порог «нет в базе знаний» — ниже него выдаётся честный отказ
ANSWER_MIN_RELEVANCE=0.45
CRITIC_ENABLED=true
CRITIC_MAX_REGENERATIONS=1
MAX_HISTORY_MESSAGES=10
DATA_DIR=/app/data
INSTRUCTIONS_DIR=/app/data/instructions
TEMPLATES_DIR=/app/data/templates
ARTIFACTS_DIR=/app/artifacts
# Водяной знак в PDF («УЧЕБНЫЙ ПРИМЕР», «КОПИЯ») набран светлой заливкой
# поверх текста, и парсер вставляет его буквы внутрь слов. Символы светлее
# порога отбрасываются при загрузке. Отключать только если светлым набран
# содержательный текст документа.
PDF_DROP_WATERMARK=true
PDF_WATERMARK_MIN_LIGHTNESS=0.3
MAX_UPLOAD_SIZE_MB=50
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.docx,.txt,.md,.html

# ─────────────────────────────── OBSERVABILITY ───────────────────────────────
METRICS_ENABLED=true
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana_password

# ─────────────────────────────── FRONTEND ───────────────────────────────
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_APP_NAME="Помощник по регламентам"
NEXT_TELEMETRY_DISABLED=1
